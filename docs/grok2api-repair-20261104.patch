+	request, err := http.NewRequest(http.MethodGet, "https://93.184.216.34:8443/image.png", nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	request.Host = "images.example.test:8443"
+	_, _ = (&Lease{ProxyURL: proxyServer.URL}).DoPinnedHTTPS(request, "images.example.test")
+	select {
+	case host := <-connected:
+		if host != "93.184.216.34:8443" {
+			t.Fatalf("proxy CONNECT host = %q", host)
+		}
+	case <-time.After(2 * time.Second):
+		t.Fatal("proxy did not receive CONNECT")
+	}
