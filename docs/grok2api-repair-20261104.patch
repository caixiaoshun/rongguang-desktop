+func TestVideoFirstFrameUploadsBeforeGeneration(t *testing.T) {
+	for _, missingMetadata := range []bool{false, true} {
+		t.Run(map[bool]string{false: "first-frame", true: "missing-metadata"}[missingMetadata], func(t *testing.T) {
+			uploads, generations := 0, 0
+			server := fhttptest.NewServer(fhttp.HandlerFunc(func(w fhttp.ResponseWriter, r *fhttp.Request) {
+				switch r.URL.Path {
+				case "/http/upload-file-v2/direct":
+					uploads++
+					if err := r.ParseMultipartForm(1 << 20); err != nil {
+						t.Error(err)
+						return
+					}
+					if r.FormValue("file_source") != imagineSelfUploadSource {
+						t.Errorf("file source missing: %q", r.FormValue("file_source"))
+					}
+
+					w.Header().Set("Content-Type", "application/json")
+					if missingMetadata {
+						w.Write([]byte(`{"fileId":"generic-only"}`))
+						return
+					}
+					w.Write([]byte(`{"uploadId":"generic-upload","fileMetadata":{"fileMetadataId":"first-frame-id","fileUri":"users/test/image.png"}}`))
+				case "/rest/app-chat/conversations/new":
+					generations++
+					var body map[string]any
+					if err := json.NewDecoder(r.Body).Decode(&body); err != nil {
+						t.Error(err)
+						return
+					}
+					media := body["mediaGenInput"].(map[string]any)
+					if _, exists := media["textToVideo"]; exists {
+						t.Error("first frame silently dropped into text-to-video")
+					}
+					input := media["imageToVideo"].(map[string]any)
+					assets := input["inputAssets"].([]any)
+					if len(assets) != 1 || assets[0] != "first-frame-id" || uploads != 1 {
+						t.Errorf("wrong first frame: %#v uploads=%d", assets, uploads)
+					}
+					w.Header().Set("Content-Type", "text/event-stream")
+					w.Write([]byte("data: {\"result\":{\"response\":{\"streamingVideoGenerationResponse\":{\"progress\":100,\"videoUrl\":\"https://assets.grok.com/video.mp4\"}}}}\n\n"))
+				default:
+					fhttp.NotFound(w, r)
+				}
+			}))
+			defer server.Close()
+			adapter, credential := testMediaAdapter(t, server.URL)
+			result, err := adapter.GenerateVideo(context.Background(), provider.VideoRequest{
+				Credential: credential, Prompt: "animate the cup", Duration: 6, Resolution: "720p",
+				ImageURL: "data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNk+A8AAQUBAScY42YAAAAASUVORK5CYII=",
+			})
+			if missingMetadata {
+				if err == nil || generations != 0 {
+					t.Fatalf("missing metadata err=%v generations=%d", err, generations)
+				}
+			} else if err != nil || result.URL == "" || generations != 1 {
+				t.Fatalf("result=%#v err=%v generations=%d", result, err, generations)
+			}
+		})
+	}
+}
