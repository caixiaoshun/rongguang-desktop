{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RongGuang",
  "version": "0.1.6",
  "identifier": "com.rongguang.video",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "frontendDist": "../../web/out"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "融光 · 正在启动",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "center": true,
        "decorations": true,
        "visible": true,
        "url": "loading.html"
      }
    ],
    "security": {
      "csp": null,
      "dangerousDisableAssetCspModification": false
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi",
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../web/out/": "web/"
    },
    "copyright": "© 2025 RongGuang",
    "category": "Video",
    "shortDescription": "AI 视频创作工作台",
    "longDescription": "融光桌面版：以 Grok 为主供应商的一站式 AI 视频创作工具，剧本、分镜、素材、成片全流程本地化运行。",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": false
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  },
  "plugins": {}
}
